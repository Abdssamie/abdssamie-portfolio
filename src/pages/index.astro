---
import Layout from '../layouts/Layout.astro';
import Ticker from '../components/Ticker.astro';
import Navigation from '../components/Navigation.astro';
---

<Layout title="Bloomshine — Scaling Tech & SaaS through Creator Partnerships">
  <Ticker />
  <Navigation />
  
  <main class="bg-black text-neutral-400 min-h-screen font-inter selection:bg-white selection:text-black pt-32">
    <!-- Hero Section -->
    <section class="min-h-[70vh] flex flex-col justify-center px-6 md:px-12 max-w-6xl mx-auto">
      <div class="space-y-12">
        <h1 class="text-white text-5xl md:text-8xl font-bold tracking-tight leading-[0.9] max-w-4xl">
          We help Tech & SaaS brands scale through trusted creator partnerships.
        </h1>
      </div>
    </section>

    <!-- Services Section -->
    <section class="py-32 px-6 md:px-12 max-w-6xl mx-auto border-t border-neutral-900">
      <div class="grid md:grid-cols-2 gap-x-24 gap-y-32">
        <div class="space-y-6">
          <h2 class="text-white text-2xl font-bold uppercase tracking-widest border-b border-neutral-800 pb-4">
            01. One-Time Collaborations
          </h2>
          <p class="text-xl leading-relaxed">
            We match your software or hardware with the perfect tech creators for dedicated YouTube and X reviews, tutorials, or short-form integrations. We handle the negotiations, briefs, and deliverables.
          </p>
        </div>
        
        <div class="space-y-6">
          <h2 class="text-white text-2xl font-bold uppercase tracking-widest border-b border-neutral-800 pb-4">
            02. Influencer Seeding
          </h2>
          <p class="text-xl leading-relaxed">
            Launching a new dev tool or app? We coordinate sending premium access keys or hardware to 15+ vetted micro-influencers to generate authentic, organic reviews at scale.
          </p>
        </div>

        <div class="space-y-6">
          <h2 class="text-white text-2xl font-bold uppercase tracking-widest border-b border-neutral-800 pb-4">
            03. Performance Strategy & Analytics
          </h2>
          <p class="text-xl leading-relaxed">
            We provide deep-dive metric tracking and ROI analysis for every campaign. Our team ensures your spend is optimized toward actual customer acquisition, not just vanity impressions.
          </p>
        </div>

        <div class="space-y-6">
          <h2 class="text-white text-2xl font-bold uppercase tracking-widest border-b border-neutral-800 pb-4">
            04. Content Rights & Licensing
          </h2>
          <p class="text-xl leading-relaxed">
            Scale your winning creative. We handle all usage rights negotiations and legal frameworks, allowing you to use creator content across your paid ads and owned channels without friction.
          </p>
        </div>
      </div>
    </section>

    <!-- Why Us Section -->
    <section class="py-32 px-6 md:px-12 max-w-6xl mx-auto border-t border-neutral-900">
      <div class="grid md:grid-cols-3 gap-12">
        <div class="space-y-4">
          <h3 class="text-white text-lg font-bold">Predictability</h3>
          <p class="text-neutral-500">
            We focus on reliable creators who follow briefs, hit deadlines, and deliver consistent metrics without the back-and-forth drama.
          </p>
        </div>
        
        <div class="space-y-4">
          <h3 class="text-white text-lg font-bold">Alignment</h3>
          <p class="text-neutral-500">
            We don't chase empty follower counts. We manually vet creators to ensure their audience actually matches your Ideal Customer Profile (ICP).
          </p>
        </div>
        
        <div class="space-y-4">
          <h3 class="text-white text-lg font-bold">Security</h3>
          <p class="text-neutral-500">
            We protect your budget. We manage the legal contracts, usage rights, payment timelines, and creative approvals for a hands-free experience.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-32 px-6 md:px-12 max-w-6xl mx-auto border-t border-neutral-900">
      <div class="grid md:grid-cols-2 gap-16">
        <div class="space-y-8">
          <h2 class="text-white text-4xl md:text-5xl font-bold tracking-tight">
            Scale your creator operations.
          </h2>
          <p class="text-xl leading-relaxed max-w-md">
            Fill out the form and we'll get back to you within 24 hours to schedule a discovery call.
          </p>
          <div class="space-y-2">
            <p class="text-sm uppercase tracking-widest text-neutral-500 font-bold">Direct Email</p>
            <a href="mailto:support@bloomshine.agency" class="text-white text-xl hover:underline">support@bloomshine.agency</a>
          </div>
        </div>

        <form action="https://api.web3forms.com/submit" method="POST" class="space-y-6">
          <input type="hidden" name="access_key" value="6378112d-7d32-4a72-b23a-3662284101fb">
          
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label for="name" class="text-sm uppercase tracking-widest font-bold text-neutral-300">Name</label>
              <input type="text" name="name" id="name" required class="w-full bg-neutral-900 border border-neutral-800 p-4 text-white focus:outline-none focus:border-white transition-colors" placeholder="Your Name" />
            </div>
            <div class="space-y-2">
              <label for="email" class="text-sm uppercase tracking-widest font-bold text-neutral-300">Email</label>
              <input type="email" name="email" id="email" required class="w-full bg-neutral-900 border border-neutral-800 p-4 text-white focus:outline-none focus:border-white transition-colors" placeholder="Your@email.com" />
            </div>
          </div>
          
          <div class="space-y-2">
            <label for="budget" class="text-sm uppercase tracking-widest font-bold text-neutral-300">Budget</label>
            <select name="budget" id="budget" required class="w-full bg-neutral-900 border border-neutral-800 p-4 text-white focus:outline-none focus:border-white transition-colors appearance-none">
              <option value="" disabled selected>Select Budget Range...</option>
              <option value="< $1k">&lt; $1k</option>
              <option value="$1k - $5k">$1k - $5k</option>
              <option value="$5k+">$5k+</option>
            </select>
          </div>
          
          <div class="space-y-2">
            <label for="message" class="text-sm uppercase tracking-widest font-bold text-neutral-300">Message</label>
            <textarea name="message" id="message" rows="5" required class="w-full bg-neutral-900 border border-neutral-800 p-4 text-white focus:outline-none focus:border-white transition-colors" placeholder="Tell us about your brand and objectives"></textarea>
          </div>
          
          <button type="submit" class="w-full bg-white text-black py-5 text-xl font-bold hover:bg-neutral-200 transition-colors uppercase tracking-widest">
            Send Message
          </button>
        </form>
      </div>
    </section>

    <!-- Footer -->
    <footer class="py-12 px-6 md:px-12 max-w-6xl mx-auto border-t border-neutral-900 text-center">
      <div class="text-neutral-700 text-sm uppercase tracking-widest font-bold">
        &copy; {new Date().getFullYear()} Bloomshine — Tech Influencer Marketing Agency
      </div>
    </footer>
  </main>
</Layout>
