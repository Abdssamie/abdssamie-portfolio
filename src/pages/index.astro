---
import Layout from '../layouts/Layout.astro';
---

<Layout title="IMA — Scaling Tech & SaaS through Creator Partnerships">
  <main class="bg-black text-neutral-400 min-h-screen font-inter selection:bg-white selection:text-black">
    <!-- Hero Section -->
    <section class="min-h-screen flex flex-col justify-center px-6 md:px-12 max-w-6xl mx-auto">
      <div class="space-y-12">
        <h1 class="text-white text-5xl md:text-8xl font-bold tracking-tight leading-[0.9] max-w-4xl">
          We help Tech & SaaS brands scale through trusted creator partnerships.
        </h1>
        
        <div class="flex flex-col sm:flex-row gap-6">
          <a 
            href="https://calendly.com/your-placeholder" 
            target="_blank"
            class="inline-block bg-white text-black px-8 py-4 text-lg font-bold hover:bg-neutral-200 transition-colors text-center"
          >
            Book a Discovery Call
          </a>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section class="py-32 px-6 md:px-12 max-w-6xl mx-auto border-t border-neutral-900">
      <div class="grid md:grid-cols-2 gap-16 md:gap-24">
        <div class="space-y-6">
          <h2 class="text-white text-2xl font-bold uppercase tracking-widest border-b border-neutral-800 pb-4">
            01. One-Time Collaborations
          </h2>
          <p class="text-xl leading-relaxed">
            We match your software or hardware with the perfect tech creators for dedicated YouTube reviews, tutorials, or short-form integrations. We handle the negotiations, briefs, and deliverables.
          </p>
        </div>
        
        <div class="space-y-6">
          <h2 class="text-white text-2xl font-bold uppercase tracking-widest border-b border-neutral-800 pb-4">
            02. Influencer Seeding <span class="text-neutral-600">(Beta)</span>
          </h2>
          <p class="text-xl leading-relaxed">
            Launching a new dev tool or app? We coordinate sending premium access keys or hardware to 15+ vetted micro-influencers to generate authentic, organic reviews at scale.
          </p>
        </div>
      </div>
    </section>

    <!-- Why Us Section -->
    <section class="py-32 px-6 md:px-12 max-w-6xl mx-auto border-t border-neutral-900">
      <div class="grid md:grid-cols-3 gap-12">
        <div class="space-y-4">
          <h3 class="text-white text-lg font-bold">Predictability</h3>
          <p class="text-neutral-500">
            We focus on reliable creators who follow briefs, hit deadlines, and deliver consistent metrics without the back-and-forth drama.
          </p>
        </div>
        
        <div class="space-y-4">
          <h3 class="text-white text-lg font-bold">Alignment</h3>
          <p class="text-neutral-500">
            We don't chase empty follower counts. We manually vet creators to ensure their audience actually matches your Ideal Customer Profile (ICP).
          </p>
        </div>
        
        <div class="space-y-4">
          <h3 class="text-white text-lg font-bold">Security</h3>
          <p class="text-neutral-500">
            We protect your budget. We manage the legal contracts, usage rights, payment timelines, and creative approvals for a hands-free experience.
          </p>
        </div>
      </div>
    </section>

    <!-- Footer / Final CTA -->
    <footer class="py-48 px-6 md:px-12 max-w-6xl mx-auto border-t border-neutral-900 text-center space-y-12">
      <h2 class="text-white text-4xl md:text-6xl font-bold tracking-tight">
        Ready to test the creator ecosystem?
      </h2>
      
      <div class="flex flex-col items-center gap-6">
        <a 
          href="https://calendly.com/your-placeholder" 
          target="_blank"
          class="inline-block bg-white text-black px-12 py-5 text-xl font-bold hover:bg-neutral-200 transition-colors"
        >
          Book a Discovery Call
        </a>
        <p class="text-lg">
          Email Us: <a href="mailto:hello@yourdomain.com" class="text-white hover:underline">hello@yourdomain.com</a>
        </p>
      </div>
      
      <div class="pt-24 text-neutral-700 text-sm uppercase tracking-widest">
        &copy; {new Date().getFullYear()} IMA — Tech Influencer Marketing Agency
      </div>
    </footer>
  </main>
</Layout>
