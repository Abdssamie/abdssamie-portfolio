---
interface ServiceTech {
  name: string;
  icon: string;
  isLocal?: boolean;
}

interface Props {
  title: string;
  icon: string;
  techs: ServiceTech[];
}

const { title, icon, techs } = Astro.props;
---

<div class="service-card">
  <div class="service-card-inner">
    <div class="service-icon">
      <i data-lucide={icon}></i>
    </div>
    <h3 class="service-title" set:html={title}></h3>
  </div>
  <div class="service-tech-ribbon" aria-label="Tech stack">
    {techs.map((tech) => (
      <img 
        src={tech.icon} 
        alt={tech.name}
        loading="lazy"
        class={tech.name.toLowerCase().includes('aws') ? 'aws-logo' : ''}
      />
    ))}
  </div>
</div>