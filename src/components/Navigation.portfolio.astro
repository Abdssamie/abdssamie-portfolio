---
interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;

const tickerItems = [
  "REVOLUTIONIZING MARKETING SINCE 2020",
  "THE NEW WAY OF MARKETING",
  "CONNECTING BRANDS WITH OVER 200+ AUTHENTIC CREATORS",
];
const tickerLoop = Array.from({ length: 4 }, () => tickerItems).flat();
---

<div class="ticker-bar">
  <div class="ticker-track">
    <span class="ticker-set">
      {tickerLoop.map((item) => <span class="ticker-item">{item}</span>)}
    </span>
    <span class="ticker-set" aria-hidden="true">
      {tickerLoop.map((item) => <span class="ticker-item">{item}</span>)}
    </span>
  </div>
</div>

<a href="/" class="top-left-logo">
  <img src="/bloomshine-logo.png" alt="Bloomshine Agency" />
</a>

<a href="#contact" class="top-right-cta">
  <div class="arrow-box">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
  </div>
  <div class="cta-text">GET IN TOUCH</div>
</a>
